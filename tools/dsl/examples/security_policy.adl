# SPDX-License-Identifier: GPL-2.0-only WITH Linux-syscall-note
#
# AirymaxOS reference LSM policy in the Airymax Decision Language (.adl).
#
# This is the L-03 compiler's end-to-end example: it is compiled by
# tools/dsl/dsl_compile.py into pure C decision tables (security_policy_tables.h)
# and exercised by the pytest suite. Every rule carries real Airy LSM semantics;
# fault codes come from the supervisor contract (09-kernel-agent-supervisor.md §2)
# and verdicts from the [SC] four-value set in security_types.h.

version "1.0.1";

# io_uring command admission: reject the reserved malformed opcode and audit
# commands that request the privileged registered-buffer flag.
table uring_guard {
	hook = uring_cmd;
	input op : u8;
	input cmd_flags : u32;

	rule 10 {
		when op == 31;
		verdict DENY;
		fault 0x100A;
	}

	rule 20 {
		when cmd_flags & 0x40000000;
		verdict AUDIT;
	}

	default verdict ALLOW;
}

# Task creation accounting: audit user-namespace creation and anonymous
# kernel worker allocation. Both verdicts are observational, so enabling the
# table cannot fail a fork that the capability checks already admitted.
table task_guard {
	hook = task_alloc;
	input clone_flags : u64;
	input task_type : u8;

	rule 5 {
		when clone_flags & 0x0000000010000000;
		verdict AUDIT;
	}

	rule 15 {
		when task_type == 0;
		verdict AUDIT;
	}

	default verdict ALLOW;
}

# File open mediation: complain on write-only opens and default to audit so
# every open is observable before path labelling can enforce. The hook's
# field vector is open_flags, acc_mode, agent_id; acc_mode 3 is read-write.
table file_open_guard {
	hook = file_open;
	input acc_mode : u8;
	input open_flags : u32;

	rule 30 {
		when acc_mode == 3;
		verdict AUDIT;
	}

	rule 40 {
		when open_flags & 0x00000001;
		verdict COMPLAIN;
	}

	default verdict AUDIT;
}
